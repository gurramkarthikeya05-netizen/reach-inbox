NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:<REPLACE_ME>@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
SESSION_SECRET=<REPLACE_ME_WITH_32_OR_MORE_CHARACTERS>
GOOGLE_CLIENT_ID=<REPLACE_ME>
GOOGLE_CLIENT_SECRET=<REPLACE_ME>
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RECIPIENTS_PER_CAMPAIGN=5000
# JSON array. Never commit real credentials.
SMTP_SENDERS_JSON=[{"id":"ethereal-primary","name":"ReachInbox Demo","email":"<REPLACE_ME>","host":"smtp.ethereal.email","port":587,"secure":false,"user":"<REPLACE_ME>","pass":"<REPLACE_ME>"}]